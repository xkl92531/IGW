<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IGW.Core\IGW.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SqlSugarCore" Version="5.1.4.221" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <!-- 只支持 SQLite / SQL Server / PostgreSQL / MySQL：SqlSugar 顺带引入的其他数据库驱动不参与编译和发布 -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.8.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="SqlSugarCore.Dm" Version="8.8.1" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="SqlSugarCore.Kdbndp" Version="9.3.8.413" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Oscar.Data.SqlClient" Version="4.0.4" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IGW.Tests" />
  </ItemGroup>

</Project>
