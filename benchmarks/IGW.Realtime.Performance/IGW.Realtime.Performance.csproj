<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>IGW.Performance</AssemblyName>
    <!-- 与 Microsoft.NET.Sdk.Web 的正式 Runtime 一致，避免用 Workstation GC 误判百万点尾延迟。 -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\IGW.Abstractions\IGW.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\IGW.Core\IGW.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>
</Project>
