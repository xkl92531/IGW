<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <AssemblyName>IGW 发码工具</AssemblyName>
    <RootNamespace>IgwKeygenGui</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IGW.Licensing\IGW.Licensing.csproj" />
  </ItemGroup>

  <!-- publish.ps1 传入用管理员密码加密过的私钥(-p:ProtectedKeyFile=...)，嵌进 exe；平时编译不嵌，照旧找 private.key 文件 -->
  <ItemGroup Condition="'$(ProtectedKeyFile)' != ''">
    <EmbeddedResource Include="$(ProtectedKeyFile)" LogicalName="IgwKeygenGui.private.key.protected" />
  </ItemGroup>
  <Target Name="CheckProtectedKeyFile" BeforeTargets="PrepareForBuild" Condition="'$(ProtectedKeyFile)' != ''">
    <Error Condition="!Exists('$(ProtectedKeyFile)')" Text="找不到加密私钥文件 $(ProtectedKeyFile)" />
  </Target>

</Project>
