<Window x:Class="IgwKeygenGui.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IGW 发码工具 - 管理员验证" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen" Background="#F3F5F8"
        FocusManager.FocusedElement="{Binding ElementName=PasswordBox}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="请输入管理员密码" FontSize="16" FontWeight="Bold" Foreground="#213247"/>
        <TextBlock Text="发码私钥已加密内嵌在本程序中，输对管理员密码才能使用。" Foreground="#8A94A6" FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap"/>
        <PasswordBox x:Name="PasswordBox" Padding="6,5" BorderBrush="#C7CDD6" KeyDown="PasswordBox_KeyDown"/>
        <TextBlock x:Name="ErrorText" Foreground="#C0392B" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="退出" Click="Cancel_Click" Padding="16,6" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="确定" Click="Ok_Click" Padding="16,6"
                    Background="#1A5FB4" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
        </StackPanel>
    </StackPanel>
</Window>
